{
  "expo": {
    "name": "POSFront",
    "slug": "POSFront",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./app/assets/images/kiosco-logo.png",
    "scheme": "posfront",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Esta app mecesita acceso a la camasra",
        "NSPhotoLibraryUsageDescription": "Esta app necesita acceso a la galeria",
        "NSPhotoLibraryAddUsageDescription": "Esta app necesita accesp a la galeria para añadir fotos"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./app/assets/images/kiosko-fondo.png",
        "backgroundImage": "./app/assets/images/kiosko-fondo.png",
        "monochromeImage": "./app/assets/images/kiosko-fondo.png"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ],
      "predictiveBackGestureEnabled": false,
      "package": "com.pamela123.POSFront"
    },
    "web": {
      "output": "static",
      "favicon": "./app/assets/images/kiosco-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./app/assets/images/kiosco-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b24e2777-da3d-4817-b552-e238a9811d80"
      }
    }
  }
}
